---
interface Props {
  text: string;
  center?: string;
  class?: string;
}
const { text, center = '', class: className = '' } = Astro.props;
const id = `stamp-${Math.random().toString(36).slice(2, 8)}`;
---
<div class={`stamp ${className}`} aria-hidden="true">
  <svg viewBox="0 0 200 200" class="ring">
    <defs>
      <path id={id} d="M100,100 m-74,0 a74,74 0 1,1 148,0 a74,74 0 1,1 -148,0" />
    </defs>
    <text><textPath href={`#${id}`} startOffset="0" textLength="460" lengthAdjust="spacing">{text}</textPath></text>
  </svg>
  <span class="center">{center}</span>
</div>

<style>
  .stamp {
    position: relative;
    width: var(--size, 150px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    display: grid;
    place-items: center;
    box-shadow: 0 18px 40px -16px rgb(20 27 61 / 0.55);
  }
  .ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    animation: spin 36s linear infinite;
  }
  text {
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    fill: currentColor;
  }
  .center {
    font-family: var(--serif);
    font-style: italic;
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
    font-size: calc(var(--size, 150px) * 0.26);
    line-height: 1;
    color: var(--sun);
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
