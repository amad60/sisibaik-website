---
import Photo from '../Photo.astro';
import Scribble from '../Scribble.astro';
import Stamp from '../Stamp.astro';
import Icon from '../Icon.astro';
import { FOUNDED_YEAR, site } from '../../data/site';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="blob" aria-hidden="true"></div>
  <div class="wrap grid">
    <div class="copy">
      <p class="eyebrow" data-reveal>Yayasan Sisi Baik Manusia &middot; Depok</p>
      <h1 id="hero-title" class="display" data-reveal style="--d:.08s">
        Setiap anak berhak atas <span class="ital accent">peluang</span> yang <Scribble>sama.</Scribble>
      </h1>
      <p class="lede" data-reveal style="--d:.18s">{site.tagline}</p>
      <div class="ctas" data-reveal style="--d:.26s">
        <a class="btn" href="/do-donate/">Jadi Warga Baik <Icon name="arrow" class="arrow" /></a>
        <a class="btn btn--ghost" href="#program">Kenali programnya</a>
      </div>
      <ul class="facts" data-reveal style="--d:.34s">
        <li><strong>Sejak {FOUNDED_YEAR}</strong> warisan Edukasi Dasar</li>
        <li><strong>Bebas biaya</strong> kelas calistung untuk anak</li>
      </ul>
    </div>

    <div class="collage">
      <div class="sun" data-parallax="-0.06" aria-hidden="true"></div>
      <figure class="main frame" data-reveal="mask">
        <Photo name="tien-bersama-murid" alt="Ibu Tien Suryantini tersenyum dikelilingi murid-muridnya di ruang kelas" sizes="(min-width: 1000px) 40vw, 92vw" eager position="50% 30%" />
      </figure>
      <figure class="print tape side" data-parallax="0.07" data-reveal style="--d:.5s">
        <Photo name="karya-siswa" alt="Seorang siswi Indonesia Bisa Membaca memperlihatkan hasil karyanya" sizes="240px" widths={[300, 480]} position="50% 20%" />
        <figcaption>Karya siswa, 2024</figcaption>
      </figure>
      <Stamp class="badge" text={`Edukasi Dasar • Indonesia Bisa Membaca • `} center={String(FOUNDED_YEAR)} />
      <p class="tag" data-reveal style="--d:.7s">
        <span class="line" aria-hidden="true"></span>
        Ibu Tien Suryantini bersama murid-muridnya
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(7.5rem, 13vw, 10.5rem);
    padding-bottom: clamp(3.5rem, 7vw, 6rem);
    overflow: clip;
  }
  .blob {
    position: absolute;
    right: -18vw;
    top: -10vw;
    width: 72vw;
    height: 72vw;
    max-width: 1100px;
    max-height: 1100px;
    background: radial-gradient(closest-side, rgb(243 205 178 / 0.75), rgb(243 205 178 / 0) 70%);
    border-radius: 42% 58% 61% 39% / 47% 41% 59% 53%;
    pointer-events: none;
  }
  .grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .display {
    max-width: 11.5ch;
  }
  .lede {
    margin: 1.8rem 0 0;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.2rem;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 2rem;
    list-style: none;
    padding: 1.5rem 0 0;
    margin: 2.6rem 0 0;
    border-top: 1px solid var(--line);
    font-size: 0.95rem;
    color: var(--muted);
  }
  .facts strong {
    display: block;
    font-family: var(--serif);
    font-style: italic;
    font-weight: 450;
    font-size: 1.35rem;
    color: var(--ink);
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
  }

  .collage {
    position: relative;
    aspect-ratio: 0.86;
    max-width: 600px;
    width: 100%;
    justify-self: end;
  }
  .sun {
    position: absolute;
    width: 46%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #ffd06a, var(--sun) 60%, #f29a0a);
    right: -9%;
    top: -7%;
    box-shadow: 0 0 80px 10px rgb(252 168 24 / 0.25);
  }
  .main {
    position: absolute;
    inset: 4% 4% 10% 8%;
    margin: 0;
    border-radius: 34% 34% var(--radius-lg) var(--radius-lg) / 22% 22% var(--radius-lg) var(--radius-lg);
    box-shadow: 0 40px 80px -40px rgb(20 27 61 / 0.55);
  }
  .main :global(img) {
    position: absolute;
    inset: 0;
  }
  .side {
    position: absolute;
    left: -8%;
    bottom: 0;
    width: 40%;
    aspect-ratio: 0.8;
    margin: 0;
    rotate: -6deg;
    z-index: 3;
  }
  .side :global(picture) {
    display: block;
    height: 100%;
  }
  .side :global(img) {
    height: 100%;
  }
  .collage :global(.badge) {
    --size: clamp(108px, 11vw, 148px);
    position: absolute;
    left: -2%;
    top: 6%;
    z-index: 4;
  }
  .tag {
    position: absolute;
    right: 6%;
    bottom: 1.5%;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--serif);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--ink-2);
  }
  .tag .line {
    width: 34px;
    height: 1px;
    background: currentColor;
  }

  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .display {
      max-width: 13ch;
    }
    .collage {
      justify-self: center;
      max-width: 560px;
      margin-top: 1rem;
    }
  }
  @media (max-width: 560px) {
    .collage {
      aspect-ratio: 0.82;
      width: calc(100% - 1rem);
      margin-left: 1rem;
    }
    .side {
      left: -6%;
      width: 42%;
    }
    .tag {
      font-size: 0.85rem;
      right: 2%;
      bottom: -1%;
    }
    .facts {
      gap: 0.6rem 1.5rem;
    }
  }
</style>
