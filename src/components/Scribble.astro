---
interface Props {
  variant?: 1 | 2;
}
const { variant = 1 } = Astro.props;
const d =
  variant === 1
    ? 'M3 14 C 60 6, 120 4, 180 9 S 300 16, 397 6'
    : 'M4 10 C 80 18, 150 2, 220 10 S 340 14, 396 8';
---
<span class="scribble" data-reveal="fade"><slot /><svg viewBox="0 0 400 20" preserveAspectRatio="none" aria-hidden="true"><path d={d} /></svg></span>
