---
interface Props {
  name: 'arrow' | 'arrow-up-right' | 'whatsapp' | 'mail' | 'instagram' | 'youtube' | 'tiktok' | 'x' | 'copy' | 'check' | 'pin' | 'menu' | 'close' | 'download' | 'heart';
  class?: string;
  size?: number;
}
const { name, class: className = '', size } = Astro.props;
const style = size ? `width:${size}px;height:${size}px` : undefined;
---
<svg class={className} style={style} viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
  {name === 'arrow' && <path d="M4 12h15M13 6l6 6-6 6" />}
  {name === 'arrow-up-right' && <path d="M7 17 17 7M8 7h9v9" />}
  {name === 'mail' && (<><rect x="3" y="5" width="18" height="14" rx="3" /><path d="m4 7 8 6 8-6" /></>)}
  {name === 'whatsapp' && (<><path d="M4.5 19.5 5.6 16A8 8 0 1 1 8.4 18.6Z" /><path d="M9.2 8.6c.2-.5.6-.5.9-.5h.5c.2 0 .4.1.5.4l.6 1.5c.1.3 0 .5-.1.7l-.5.6c.6 1.1 1.5 2 2.7 2.6l.6-.6c.2-.2.4-.2.7-.1l1.5.7c.3.1.4.3.4.5v.5c0 .4-.2.8-.6 1-.7.4-1.6.5-2.6.1a9 9 0 0 1-4.4-4.2c-.5-1-.5-2.1-.2-3.2Z" fill="currentColor" stroke="none" /></>)}
  {name === 'instagram' && (<><rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none" /></>)}
  {name === 'youtube' && (<><rect x="2.5" y="5.5" width="19" height="13" rx="4" /><path d="m10.5 9.3 4.5 2.7-4.5 2.7Z" fill="currentColor" stroke="none" /></>)}
  {name === 'tiktok' && <path d="M14 4v10.5a3.5 3.5 0 1 1-3.5-3.5M14 4c.4 2.4 2 4 4.5 4.3" />}
  {name === 'x' && <path d="M4 4l16 16M20 4 4 20" />}
  {name === 'copy' && (<><rect x="8" y="8" width="12" height="12" rx="3" /><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" /></>)}
  {name === 'check' && <path d="m5 12.5 4.5 4.5L19 7.5" />}
  {name === 'pin' && (<><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" /><circle cx="12" cy="10" r="2.4" /></>)}
  {name === 'menu' && <path d="M4 8h16M4 16h16" />}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
  {name === 'download' && <path d="M12 4v11m-5-5 5 5 5-5M5 20h14" />}
  {name === 'heart' && <path d="M12 20s-7.5-4.4-7.5-10A4.3 4.3 0 0 1 12 7.4 4.3 4.3 0 0 1 19.5 10c0 5.6-7.5 10-7.5 10Z" />}
</svg>
