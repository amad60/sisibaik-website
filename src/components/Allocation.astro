---
import { impact } from '../data/site';

interface Props {
  tone?: 'light' | 'dark';
}
const { tone = 'light' } = Astro.props;
const colors = ['var(--blue)', 'var(--sun)', 'var(--clay)', 'var(--ink-2)'];
---
<div class:list={['alloc', tone]} data-reveal>
  <div class="top">
    <p class="k">Kebutuhan dukungan 2026</p>
    <p class="goal">{impact.goal2026}</p>
  </div>
  <div class="bar" role="img" aria-label={impact.allocation2026.map((a) => `${a.pct} persen ${a.label}`).join(', ')}>
    {impact.allocation2026.map((a, i) => <span style={`--w:${a.pct}%;--c:${colors[i]};--i:${i}`}></span>)}
  </div>
  <ul>
    {impact.allocation2026.map((a, i) => (
      <li style={`--c:${colors[i]}`}><strong>{a.pct}%</strong> {a.label}</li>
    ))}
  </ul>
</div>

<style>
  .alloc {
    padding: clamp(1.4rem, 3vw, 2.2rem);
    border-radius: var(--radius-lg);
    background: var(--paper);
    box-shadow: 0 0 0 1px var(--line);
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
  }
  .k {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .goal {
    margin: 0;
    font-family: var(--serif);
    font-style: italic;
    font-variation-settings: 'SOFT' 100, 'WONK' 1;
    font-size: clamp(1.8rem, 1.4rem + 1.4vw, 2.6rem);
    line-height: 1;
    color: var(--blue);
  }
  .bar {
    display: flex;
    gap: 4px;
    height: 16px;
    margin: 1.4rem 0 1.3rem;
  }
  .bar span {
    width: var(--w);
    background: var(--c);
    border-radius: 999px;
    transform-origin: left;
  }
  :global(.js) .bar span {
    transform: scaleX(0);
    transition: transform 1.1s var(--ease-out) calc(0.25s + var(--i) * 0.12s);
  }
  :global(.js) .is-visible .bar span {
    transform: none;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.7rem 1.4rem;
  }
  li {
    position: relative;
    padding-left: 1.2rem;
    font-size: 0.9rem;
    line-height: 1.4;
    color: var(--ink-2);
  }
  li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.35em;
    width: 0.62rem;
    height: 0.62rem;
    border-radius: 50%;
    background: var(--c);
  }
  li strong {
    color: var(--ink);
  }
  .dark {
    background: rgb(247 240 227 / 0.06);
    box-shadow: inset 0 0 0 1px rgb(247 240 227 / 0.14);
  }
  .dark .k,
  .dark li {
    color: rgb(247 240 227 / 0.78);
  }
  .dark .goal,
  .dark li strong {
    color: var(--paper);
  }
  @media (max-width: 520px) {
    ul {
      grid-template-columns: 1fr;
    }
  }
</style>
